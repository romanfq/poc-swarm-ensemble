/* The Swarm Board's appearance (GH-67). The palette is named tokens: $navy $slate $mid
   $rust $pale $line, defined once in board.py (PALETTE) because the Rich styles applied
   to table cells need the same values. Nothing below hard-codes a colour. */

Screen { background: $navy; color: $pale; }
Header { background: $slate; color: $pale; }
Footer { background: $slate; color: $pale; }

/* modal dialogs */
ModalScreen { align: center middle; }
#dialog { width: 80; max-width: 95%; height: auto; max-height: 90%; border: thick $rust;
          background: $navy; padding: 1 2; }
#dialog Label { width: 100%; margin-bottom: 1; }
#buttons { height: auto; align-horizontal: right; }
#buttons Button { margin-left: 1; }
#plan { height: 20; border: round $mid; }

/* header block */
#header-block { height: auto; border: round $mid; border-title-color: $line; padding: 0 1; }
#machine { height: auto; }
#quota-row { height: 1; }
#quota-label { width: auto; padding-left: 1; }
#quota-name { width: 9; color: $mid; }

/* columns */
#main { height: 1fr; }
#left { width: 3fr; }
#right { width: 2fr; }

/* focus-driven panels: the focused table fills the column, the others hide behind #strip */
DataTable { height: 1fr; border: round $mid; border-title-color: $line; background: $navy; }
DataTable:focus { border: round $pale; border-title-color: $pale; }
DataTable > .datatable--header { background: $slate; color: $pale; text-style: bold; }
DataTable > .datatable--cursor { background: $slate; color: $pale; }
DataTable.collapsed { display: none; }
#strip { height: 1; padding: 0 1; }
#idle { height: 1fr; content-align: center middle; text-align: center; border: round $mid; }

.hidden { display: none; }

#feed { height: 1fr; border: round $mid; border-title-color: $line; background: $navy; }
#daemon-log { height: 1fr; border: round $mid; border-title-color: $line; background: $navy; }
