/* The Swarm Board's appearance (GH-67, GH-72). Every colour is a token the active Textual
   theme defines ($background $surface $panel $foreground $primary $secondary $accent), so
   any theme re-colours the whole Board. The DAGS palette is the default "dags" theme in
   board.py; nothing below hard-codes a colour. */

Screen { background: $background; color: $foreground; }
Header { background: $panel; color: $foreground; }
Footer { background: $panel; color: $foreground; }

/* modal dialogs */
ModalScreen { align: center middle; }
#dialog { width: 80; max-width: 95%; height: auto; max-height: 90%; border: thick $accent;
          background: $surface; padding: 1 2; }
#dialog Label { width: 100%; margin-bottom: 1; }
#prompt-scroll { height: auto; max-height: 20; }
#buttons { height: auto; align-horizontal: right; }
#buttons Button { margin-left: 1; }
#plan { height: 20; border: round $secondary; }

/* issue composer */
#composer { width: 100; max-width: 98%; height: 95%; border: thick $accent; background: $surface; padding: 1 2; }
#composer-form { height: 1fr; }
#composer Label { margin-bottom: 0; color: $secondary; }
#f-body { height: 8; }
#f-labels, #f-depends { height: 6; }
.problem { color: $error; height: auto; }
#preview { height: auto; margin-top: 1; }
#composer-status { height: auto; }

/* header block */
#header-block { height: auto; border: round $secondary; border-title-color: $foreground; padding: 0 1; }
#machine { height: auto; }
#quota-row { height: 1; }
#quota-label { width: auto; padding-left: 1; }
#quota-name { width: 9; color: $secondary; }

/* columns */
#main { height: 1fr; }
#left { width: 3fr; }
#right { width: 2fr; }

/* focus-driven panels: the focused table fills the column, the others hide behind #strip */
DataTable { height: 1fr; border: round $secondary; border-title-color: $foreground; background: $surface; }
DataTable:focus { border: round $foreground; border-title-color: $foreground; }
DataTable > .datatable--header { background: $panel; color: $foreground; text-style: bold; }
DataTable > .datatable--cursor { background: $panel; color: $foreground; }
DataTable.collapsed { display: none; }
#strip { height: 1; padding: 0 1; }
#idle { height: 1fr; content-align: center middle; text-align: center; border: round $secondary; }

.hidden { display: none; }

#feed { height: 1fr; border: round $secondary; border-title-color: $foreground; background: $surface; }
#daemon-log { height: 1fr; border: round $secondary; border-title-color: $foreground; background: $surface; }
